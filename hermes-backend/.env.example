PORT=4000
NODE_ENV=production

# openssl rand -hex 32
AUTH_TOKEN=replace-with-a-long-random-token
# Same as AUTH_TOKEN or a separate secret for the Telegram webhook
WEBHOOK_SECRET=replace-with-a-long-random-token

DB_PATH=/var/lib/hermes/hermes.db
LOG_PATH=/var/log/hermes/app.log

# Comma-separated allowlist for CORS (REST + Socket.io)
CORS_ORIGINS=http://localhost:3000,https://hrms.gelecekbul.com

BINANCE_API_BASE=https://api.binance.com
